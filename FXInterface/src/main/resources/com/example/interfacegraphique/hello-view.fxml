<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.interfacegraphique.HelloController" fx:id="root" prefWidth="1300" prefHeight="800">
  <!-- Background Media -->
  <MediaView fx:id="backgroundMediaView" visible="true" preserveRatio="false"/>
  <!-- Main Content -->
  <BorderPane fx:id="rootPane">
    <top>
      <HBox alignment="CENTER" spacing="20" VBox.vgrow="NEVER">
        <Button text="□" styleClass="window-button" onAction="#handleMaximiseAndPlayMusic"/>
        <Button text="◱" styleClass="window-button" onAction="#handleRestoreAndPlayMusic"/>
        <!-- Restaurer -->
        <Region HBox.hgrow="ALWAYS"/>
        <ImageView fx:id="bottomRightImage" fitWidth="250" fitHeight="200" preserveRatio="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="—" styleClass="window-button" onAction="#handleMinimizeAndPlayMusic"/>
        <!-- minimise -->
        <Button text="✕" styleClass="window-button" onAction="#handleClose"/>
      </HBox>
    </top>

    <center>
      <StackPane fx:id="centerPane" alignment="CENTER">
        <!-- 1) boussole (visible par défaut) -->
        <StackPane fx:id="compassContainer" prefWidth="100" prefHeight="100" alignment="CENTER"/>
        <!-- 2) Le ScrollPane (caché au lancement) -->
        <ScrollPane fx:id="sideScrollPane" id="sideScrollPane"
                                              fitToWidth="true"
                                              visible="true"
                                              pickOnBounds="false"
                                              
                                              >
          <VBox fx:id="contentBox"
                                                spacing="20"
                                                alignment="TOP_CENTER">
            <!-- Filler pour forcer le scroll -->
            <!--Region prefHeight="50"/-->
            <ImageView fx:id="imageView" 
                                                         fitWidth="600"
                                                         preserveRatio="true"
                                                         visible="false"/>
            <TextArea fx:id="consoleOutput" id ="consoleOutput"
                                                        prefWidth="550"
                                                        prefHeight="50"
                                                        wrapText="true"
                                                        editable="false"
                                                        opacity="0.0"/>
          </VBox>
        </ScrollPane>
      </StackPane>
    </center>

    <bottom>
      <HBox alignment="CENTER" spacing="20" VBox.vgrow="NEVER">
        <Button fx:id="RECOGNITION" text="RECOGNITION" styleClass="button-container" onAction="#handleRecognitionAndPlayMusic"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="CONSTELLATION" text="CONSTELLATION" styleClass="button-container" onAction="#handleConstellationAndPlayMusic"/>
      </HBox>
    </bottom>
  </BorderPane>
</StackPane>
