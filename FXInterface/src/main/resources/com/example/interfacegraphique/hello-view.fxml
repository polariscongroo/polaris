<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.interfacegraphique.HelloController">
    
    <!-- Fond vidéo -->
    <MediaView fx:id="backgroundMediaView" fitWidth="${rootPane.width}" fitHeight="${rootPane.height}"/>
    
    <!-- Couche de contenu -->
    <Pane fx:id="contentPane" style="-fx-background-color: rgba(0,0,0,0.5);" 
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <!-- Titre -->
        <Label fx:id="titleLabel" text="POLARIS" styleClass="header" 
               AnchorPane.topAnchor="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>
        
        <!-- Boutons principaux -->
          <VBox alignment="CENTER" spacing="40" 
                AnchorPane.topAnchor="300" AnchorPane.leftAnchor="100" AnchorPane.rightAnchor="100">
              <Button fx:id="recognitionButton" text="Start" 
                      onAction="#handleRecognition" prefWidth="200" prefHeight="60"/>
          </VBox>
        
        <!-- Barre de progression -->
        <ProgressBar fx:id="progressBar" progress="0" prefWidth="400" 
                    AnchorPane.bottomAnchor="100" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>
        
        <!-- Boutons de contrôle -->
        <HBox alignment="CENTER" spacing="20" 
              AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <Button text="+" onAction="#increaseProgress" style="-fx-font-size: 20;"/>
            <Button text="-" onAction="#decreaseProgress" style="-fx-font-size: 20;"/>
        </HBox>
    </Pane>
</AnchorPane>